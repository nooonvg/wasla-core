{
  "name": "wasla-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA CORE \u2014 shared operating layer, shared engines, event backbone, fulfillment coordination.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "replay": "vite-node src/platform/replay/main.ts --",
    "revive": "vite-node src/platform/replay/revive-main.ts --",
    "bootstrap:credential": "vite-node src/platform/bootstrap/main.ts --",
    "test": "npm run test:suite && npm run test:cluster",
    "check:governance": "node scripts/check-governance.mjs",
    "check:roadmap": "node scripts/check-roadmap.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:test-partition": "node scripts/check-test-partition.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:governance && npm run check:contracts && npm run check:test-partition",
    "db:status": "node scripts/db-migrate.mjs status",
    "db:up": "node scripts/db-migrate.mjs up",
    "db:down": "node scripts/db-migrate.mjs down",
    "test:suite": "WASLA_TEST_PASS=suite vitest run",
    "test:cluster": "WASLA_TEST_PASS=cluster vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
